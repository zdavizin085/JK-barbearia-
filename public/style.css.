:root{color-scheme:dark;--bg:#101010;--panel:#1a1a1a;--gold:#d8b56a;--text:#f5f0e6;--muted:#b4aca0}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.55 system-ui,-apple-system,Segoe UI,sans-serif}a{color:inherit;text-decoration:none}header{max-width:1160px;margin:auto;padding:24px;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{font-size:24px;font-weight:900;letter-spacing:2px;color:var(--gold)}.brand span{font-size:13px;color:var(--text);letter-spacing:3px}nav{display:flex;gap:22px;font-size:14px}nav a:hover{color:var(--gold)}.hero{min-height:550px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:70px max(24px,calc((100vw - 1112px)/2));background:linear-gradient(90deg,#101010 20%,#101010c9 70%,#101010aa),radial-gradient(circle at 85% 35%,#7b5a2b 0,transparent 46%)}.eyebrow{font-size:12px;letter-spacing:3px;font-weight:800;color:var(--gold)}h1{font-size:clamp(48px,7vw,88px);line-height:1.05;max-width:750px;letter-spacing:-3px;margin:24px 0}h1 em{color:var(--gold);font-style:normal}h2{font-size:clamp(32px,4vw,50px);line-height:1.1;margin:16px 0 32px}.hero p{max-width:500px;color:var(--muted);font-size:19px;margin-bottom:34px}.btn{display:inline-block;background:var(--gold);color:#15120d;border:0;border-radius:4px;font-weight:900;letter-spacing:1px;padding:16px 24px;cursor:pointer;text-align:center}.btn:hover{background:#efd08c}.btn:disabled{opacity:.6;cursor:wait}.section{max-width:1160px;margin:auto;padding:85px 24px}.services{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.services article{padding:26px;background:var(--panel);border:1px solid #363027;border-radius:8px}.services article span{color:var(--gold);font-weight:800}.services h3{font-size:22px}.services p,.booking p,.muted{color:var(--muted)}.booking{display:grid;grid-template-columns:1fr 1fr;gap:70px}form{background:var(--panel);border:1px solid #3b3429;border-radius:12px;padding:28px;display:grid;gap:18px}label{display:grid;gap:8px;font-weight:600;font-size:14px}input,select{background:#111;border:1px solid #504739;color:#fff;padding:14px;border-radius:5px;width:100%;font:inherit}input:focus,select:focus{outline:2px solid var(--gold)}small{color:var(--muted)}#feedback{margin:0;font-weight:600}footer{border-top:1px solid #363027;padding:30px 24px;display:flex;justify-content:space-between;gap:16px;max-width:1160px;margin:auto;color:var(--muted)}footer strong{color:var(--gold)}@media(max-width:750px){header{align-items:flex-start;flex-direction:column}nav{gap:16px}.hero{min-height:480px}h1{letter-spacing:-1px}.services{grid-template-columns:1fr 1fr}.booking{grid-template-columns:1fr;gap:20px}footer{flex-direction:column}}@media(max-width:450px){.services{grid-template-columns:1fr}form{padding:20px}}
